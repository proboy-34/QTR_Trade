# ---------------------------------------------------------------------------
# Modes — real-money trading is disabled and no live order adapter exists.
# DEMO_MODE=true switches to SYNTHETIC demo data (clearly labelled DEMO everywhere). Keep false
# for real market data. EXECUTION_MODE: paper | testnet | live_disabled ("live" is rejected).
# ---------------------------------------------------------------------------
APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
DEMO_MODE=false
EXECUTION_MODE=paper

DATABASE_URL=sqlite:///./qtr.db
LOG_LEVEL=INFO
DEFAULT_SYMBOL=BTCUSDT
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Authentication: local_demo (single local operator) or token (AUTH_TOKENS="token:role|role,...";
# roles: viewer, researcher, trader, admin). Use a real identity provider before exposing QTR.
AUTH_MODE=local_demo
AUTH_TOKENS=

# ---------------------------------------------------------------------------
# Portfolio & risk (fractions of equity)
# ---------------------------------------------------------------------------
# Paper account initial capital (USD). Persisted when the account is first used; changing it
# later does not create or remove capital (start a fresh database for a new experiment).
STARTING_EQUITY=100000
MAX_RISK_PER_TRADE=0.01
MAX_TOTAL_EXPOSURE=0.50
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.15
MAX_OPEN_POSITIONS=5
# Total risk to stops across all open positions (fraction of equity).
MAX_PORTFOLIO_RISK=0.05
MAX_LEVERAGE=1
MAX_SYMBOL_CONCENTRATION=0.25
MAX_CORRELATED_EXPOSURE=0.35
CORRELATION_THRESHOLD=0.7
# Minimum reward:risk for a trade proposal; data older than N bars rejects a trade.
MIN_REWARD_RISK=1.5
MARKET_DATA_MAX_AGE_BARS=3

# ---------------------------------------------------------------------------
# Paper venue realism
# ---------------------------------------------------------------------------
PAPER_IMMEDIATE_FILL=true
PAPER_PARTIAL_FILL_RATIO=1
PAPER_FEE_RATE=0.0004
PAPER_SLIPPAGE_RATE=0.0002
PAPER_SPREAD_BPS=2
PAPER_LATENCY_MS=0
MARKET_DATA_STALE_SECONDS=7200

# ---------------------------------------------------------------------------
# Binance — public market data needs NO key. A mainnet key (READ-ONLY, withdrawals disabled)
# is only used to verify account permissions; it never places orders.
# Spot Testnet keys (https://testnet.binance.vision) are separate and used only when
# EXECUTION_MODE=testnet. The testnet host is fixed in code and cannot be redirected.
# ---------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Read-only account verification host (only used when a key AND secret are configured).
BINANCE_ACCOUNT_BASE_URL=https://api.binance.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Public market data host (market data only; no account/order endpoints).
BINANCE_PUBLIC_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

LIVE_PAPER_AUTOSTART=false
LIVE_PAPER_PROVIDER=binance
LIVE_PAPER_SYMBOL=BTCUSDT
# Optional multi-asset live stream, e.g. BTCUSDT,ETHUSDT,SOLUSDT (empty = LIVE_PAPER_SYMBOL only)
LIVE_PAPER_SYMBOLS=
LIVE_PAPER_TIMEFRAME=1h
LIVE_PAPER_BOOTSTRAP_CANDLES=120
LIVE_PAPER_MAX_BACKOFF_SECONDS=30

# ---------------------------------------------------------------------------
# Multi-asset universe & scanner (dynamic from exchange metadata — no hardcoded coin list)
# ---------------------------------------------------------------------------
UNIVERSE_PROVIDER=binance
UNIVERSE_QUOTE_ASSETS=USDT
UNIVERSE_MIN_QUOTE_VOLUME_24H=20000000
UNIVERSE_MAX_SPREAD_BPS=15
UNIVERSE_MAX_ABS_CHANGE_24H_PCT=40
UNIVERSE_MIN_HISTORY_CANDLES=200
UNIVERSE_MAX_ASSETS=25
UNIVERSE_EXCLUDE_BASES=USDC,FDUSD,TUSD,USDP,DAI,BUSD,EUR,TRY,BRL,GBP,AEUR,USDE,PAXG,WBTC,WBETH,BFUSD,XUSD,RLUSD
UNIVERSE_INCLUDE_SYMBOLS=
UNIVERSE_REFRESH_SECONDS=21600
MARKET_SCANNER_ENABLED=true
SCANNER_EXCHANGE=binance
SCANNER_TIMEFRAMES=1h
SCANNER_INTERVAL_SECONDS=300
# REST closed-candle loop: the core paper loop (sync -> monitor -> scan -> decide). No WebSocket needed.
CANDLE_CYCLE_ENABLED=true
CANDLE_CYCLE_INTERVAL_SECONDS=60
CANDLE_CLOSE_GRACE_SECONDS=5
# Closed candles kept per eligible asset for research (IS/OOS/walk-forward need depth).
RESEARCH_HISTORY_CANDLES=2000
# Paper fills use the real Binance bid/ask; a quote older than this is rejected by Risk.
QUOTE_MAX_AGE_SECONDS=30
# Standalone sync/scan jobs run only when CANDLE_CYCLE_ENABLED=false.
MARKET_SYNC_ENABLED=true
MARKET_SYNC_INTERVAL_SECONDS=300
OPPORTUNITY_TTL_MINUTES=240

# ---------------------------------------------------------------------------
# News & macro intelligence (empty = manual events only; QTR never invents news)
# Finnhub: crypto news + economic calendar (the calendar may not be on your plan; QTR detects
# and reports NOT_AVAILABLE_ON_PLAN). FRED: macro series with point-in-time vintages (ALFRED).
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=
FINNHUB_NEWS_ENABLED=true
# Set false when your Finnhub plan does not include /calendar/economic (HTTP 403).
FINNHUB_CALENDAR_ENABLED=true
NEWS_INGESTION_INTERVAL_SECONDS=900
FRED_API_KEY=
FRED_SERIES=DFF,DGS2,DGS10,T10Y2Y,CPIAUCSL,UNRATE,PAYEMS,M2SL
FRED_HISTORY_YEARS=10
MACRO_INGESTION_INTERVAL_SECONDS=21600
# Real provider verification (results persisted and shown in System health)
PROVIDER_CHECK_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# AI research assistant (researcher only — never places or sizes orders)
# ---------------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
# A model can be listed yet refuse generation; verification performs a real generation call.
GEMINI_MODEL=gemini-3.8-flash
# AI trade decision: required (default: a paper order needs a structured Gemini TRADE decision; any AI
# failure = NO_TRADE) | veto | advisory | off. The AI can never force a trade or bypass Risk.
AI_TRADE_REVIEW=required
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
# Budgets in USD; cost rates are approximate USD per 1M tokens — set them for your model.
AI_DAILY_BUDGET=1.0
AI_MONTHLY_BUDGET=20.0
AI_MAX_REQUESTS_PER_HOUR=30
AI_INPUT_COST_PER_MTOK=0.30
AI_OUTPUT_COST_PER_MTOK=2.50

# ---------------------------------------------------------------------------
# Research & learning loop
# ---------------------------------------------------------------------------
AUTONOMOUS_RESEARCH_ENABLED=true
RESEARCH_INTERVAL_SECONDS=600
RESEARCH_MAX_HYPOTHESES_PER_RUN=3
LEARNING_INTERVAL_SECONDS=900
COUNTERFACTUAL_HORIZON_BARS=12

# ---------------------------------------------------------------------------
# Safety monitor (automatic safe mode; cleared only by an operator)
# ---------------------------------------------------------------------------
SAFETY_MONITOR_INTERVAL_SECONDS=60
SAFETY_MAX_STALE_SECONDS=900
SAFETY_MAX_EXECUTION_ERRORS=5
SAFETY_MAX_PRICE_JUMP_PCT=25

# Other providers (not used by this build; kept empty)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_CATEGORIES=system,connection,trade,risk,order,position,intelligence,summary
